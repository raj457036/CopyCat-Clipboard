<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Allow cleartext HTTP for LAN Instant Sync.
        Peers are on arbitrary RFC-1918 IPs which cannot be enumerated in
        domain-config (no CIDR support). Cleartext is acceptable here because
        all traffic stays on the local network and is authenticated with
        HMAC-SHA256.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>